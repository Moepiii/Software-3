# Bloquear scripts de postinstall, preinstall, etc.
ignore-scripts=true

# Bloquear dependencias que vienen de repositorios Git (vector común de ataques)
allow-git=false

# Exigir que los paquetes tengan al menos 7 días de publicados
# Esto evita instalar paquetes maliciosos de día cero (recién creados)
min-release-age=7d

# Forzar que siempre se guarden versiones exactas en el package.json
save-exact=true