// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator db {
  provider = "go run github.com/steebchen/prisma-client-go"
  output   = "./db"
}

// Aqui arranca la refactorizacion xddd
// Basicamente se van a unir las tablas de personas y empresas en una sola de usuarios

enum TipoUsuario {
  NATURAL   // Personas naturales (usan cedula)
  JURIDICO  // Empresas (usan rif)
  ADMIN     // Administradores de la plataforma
}

model Usuarios {
  id             String      @id @default(uuid())
  email          String      @unique
  password_hash  String
  tipo           TipoUsuario
  role           String      @default("user") // user o admin
  
  // Campo generico para identificacion (Cedula o RIF). 
  // Para los ADMIN puede ser opcional (nullable) o vacio
  identificacion String?     @unique 

  // El nombre completo ira aqui:
  // - Personas: "Nombres Apellidos"
  // - Empresas: "Razon Social / Nombre Empresa"
  // - Admin: "Nombre del Administrador"
  nombre         String      

  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt
  
  // Relaciones
  estado_id      String?
  estado         Estado?       @relation(fields: [estado_id], references: [id], onDelete: SetNull)
  deudas         Deuda[]
  inscripciones  Inscripcion[]

  @@map("usuarios")
}

model Estado {
  id       String     @id @default(uuid())
  nombre   String     @unique
  usuarios Usuarios[]
  tasas    TasaEstado[]

  @@map("estados")
}

model TasaEstado {
  id           String    @id @default(uuid())
  estado_id    String
  porcentaje   Float
  valido_desde DateTime  @default(now())
  valido_hasta DateTime?
  estado       Estado    @relation(fields: [estado_id], references: [id], onDelete: Cascade)

  @@index([estado_id, valido_desde, valido_hasta])
  @@map("tasa_estados")
}

// Lo mismo que para los usuarios xd se estaran unificando las tablas de deudas de personas y empresas en una sola
model Deuda {
  id         String   @id @default(uuid())
  usuario_id String
  monto      Float
  vigente    Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  usuario    Usuarios @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@index([usuario_id, vigente])
  @@map("deudas")
}

model Curso {
  id          String   @id @default(uuid())
  titulo      String
  descripcion String
  fechaInicio String
  fechaFin    String
  estado      String   @default("planificado") // activo, planificado, finalizado
  categoria   String?
  imagen      String?

  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  inscripciones Inscripcion[]

  @@map("cursos")
}

model Inscripcion {
  id         String   @id @default(uuid())
  usuario_id String
  curso_id   String
  estado     String   @default("activa") // activa, cancelada, completada
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  usuario    Usuarios @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  curso      Curso    @relation(fields: [curso_id], references: [id], onDelete: Cascade)

  @@unique([usuario_id, curso_id])
  @@index([curso_id])
  @@index([usuario_id])
  @@map("inscripciones")
}
