// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator db {
  provider = "go run github.com/steebchen/prisma-client-go"
}

model Personas {
  cedula        String   @id
  email         String   @unique
  password_hash String
  nombres       String
  apellidos     String
  role          String   @default("user")
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  estado_id     String?
  estado        Estado?  @relation(fields: [estado_id], references: [id], onDelete: SetNull)
  deudas        Deuda[]

  @@map("personas")
}

model Empresas {
  rif           String   @id
  email         String   @unique
  password_hash String
  nombre_empresa String
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  estado_id     String?
  estado        Estado?  @relation(fields: [estado_id], references: [id], onDelete: SetNull)
  deudas        DeudaEmpresa[]

  @@map("empresas")
}

model Estado {
  id        String       @id @default(uuid())
  nombre    String       @unique
  personas  Personas[]
  empresas  Empresas[]
  tasas     TasaEstado[]

  @@map("estados")
}

model TasaEstado {
  id           String    @id @default(uuid())
  estado_id    String
  porcentaje   Float
  valido_desde DateTime  @default(now())
  valido_hasta DateTime?
  estado       Estado    @relation(fields: [estado_id], references: [id], onDelete: Cascade)

  @@index([estado_id, valido_desde, valido_hasta])
  @@map("tasa_estados")
}

model Deuda {
  id             String   @id @default(uuid())
  persona_cedula String
  monto          Float
  vigente        Boolean  @default(true)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  persona        Personas @relation(fields: [persona_cedula], references: [cedula], onDelete: Cascade)

  @@index([persona_cedula, vigente])
  @@map("deudas")
}

model DeudaEmpresa {
  id          String   @id @default(uuid())
  empresa_rif String
  monto       Float
  vigente     Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  empresa     Empresas @relation(fields: [empresa_rif], references: [rif], onDelete: Cascade)

  @@index([empresa_rif, vigente])
  @@map("deudas_empresas")
}
